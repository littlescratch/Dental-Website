---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (Error 404)"
  description="The page you are looking for does not exist or has been moved. Return to the Apex Dental Studio Harley Street homepage or contact our team for assistance."
>
  <section class="min-h-[75vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-cyan-50/50 via-white to-slate-50">
    <div class="max-w-xl w-full text-center">
      <!-- Dental-themed visual badge -->
      <div class="relative mx-auto mb-8 flex h-32 w-32 items-center justify-center rounded-3xl bg-cyan-100/90 text-cyan-700 shadow-inner">
        <!-- SVG Dental Tooth Icon -->
        <svg class="h-20 w-20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2C8 2 6 4 6 8c0 3.5 1.5 6 2 9 .4 2.5 1.5 4 4 4s3.6-1.5 4-4c.5-3 2-5.5 2-9 0-4-2-6-6-6Z" />
          <path d="M9 10c1.5 1 4.5 1 6 0" />
        </svg>
        <!-- 404 badge tag -->
        <span class="absolute -top-2 -right-2 inline-flex items-center rounded-full bg-rose-600 px-3 py-1 text-xs font-black text-white shadow-md">
          404
        </span>
      </div>

      <!-- Explanatory Heading -->
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-700">Error 404 • Page Missing</span>
      <h1 class="mt-2 text-3xl sm:text-4xl font-black tracking-tight text-slate-900">
        Looks like this tooth has gone missing!
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed max-w-md mx-auto">
        The link you followed may have expired, changed its location, or been temporarily extracted. Don't worry—we can easily get you back on track to a healthy smile.
      </p>

      <!-- Primary Action CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-cyan-600 px-6 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all active:scale-[0.98]"
          id="error-return-home"
        >
          <svg class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
          Return to Homepage
        </a>
        <a
          href="/#appointment"
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-slate-800 border border-slate-200 shadow-xs hover:bg-slate-50 hover:text-cyan-700 transition-all"
          id="error-book-btn"
        >
          Book an Appointment
        </a>
      </div>

      <!-- Popular Dental Pages Shortcuts -->
      <div class="mt-12 pt-8 border-t border-slate-200/90">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Explore Popular Treatments</p>
        <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-semibold text-slate-700">
          <a href="/#services" class="hover:text-cyan-600 transition-colors">Airflow Hygiene</a>
          <span class="text-slate-300">•</span>
          <a href="/#services" class="hover:text-cyan-600 transition-colors">Invisalign®</a>
          <span class="text-slate-300">•</span>
          <a href="/#services" class="hover:text-cyan-600 transition-colors">Dental Implants</a>
          <span class="text-slate-300">•</span>
          <a href="/#services" class="hover:text-cyan-600 transition-colors">Composite Bonding</a>
          <span class="text-slate-300">•</span>
          <a href="/#technology" class="hover:text-cyan-600 transition-colors">3D Digital Scans</a>
        </div>
      </div>

      <!-- Emergency Dental Notice -->
      <div class="mt-8 rounded-2xl bg-cyan-50/90 border border-cyan-100 p-4 text-xs text-slate-700">
        <span class="font-bold text-cyan-950">Experiencing acute dental pain?</span>
        <span class="block sm:inline sm:ml-1">
          Call our Harley Street emergency on-call team directly at <a href="tel:02079460912" class="font-bold text-cyan-700 underline underline-offset-2">020 7946 0912</a>.
        </span>
      </div>
    </div>
  </section>
</BaseLayout>
