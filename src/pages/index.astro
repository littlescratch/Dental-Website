---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

// Professional Dental Photography Assets
import heroImage from '../assets/images/hero-consultation.jpg';
import clinicImage from '../assets/images/clinic-interior.jpg';
import techImage from '../assets/images/dental-technology.jpg';
import smileImage from '../assets/images/smile-results.jpg';

// Clinical Specialties Data (UK Private Dental Practice)
const specialties = [
  {
    id: 'preventive',
    title: 'Preventive Care & Dental Hygiene',
    category: 'Essential Health',
    description: 'Comprehensive 14-point oral health checks, digital low-dose radiography, oral cancer screenings, and gentle EMS Airflow guided biofilm polish.',
    feeGuide: 'From £95',
    features: ['Airflow stain removal', 'Periodontal assessment', 'Oral cancer check'],
    ctaText: 'Book Hygiene Visit',
    icon: 'shield'
  },
  {
    id: 'cosmetic',
    title: 'Cosmetic Dentistry & Smile Design',
    category: 'Aesthetic Dentistry',
    description: 'Handcrafted composite edge bonding, ultra-thin porcelain veneers, and Enlighten / Boutique whitening to elevate your smile with natural elegance.',
    feeGuide: 'Bonding from £195/tooth',
    features: ['Natural composite bonding', 'Custom porcelain veneers', 'Enlighten 98% B1 shade guarantee'],
    ctaText: 'Explore Smile Design',
    icon: 'sparkles'
  },
  {
    id: 'implants',
    title: 'Precision Dental Implants',
    category: 'Restorative Care',
    description: 'Permanent, lifelike tooth replacements engineered with 3D CBCT bone planning and guided surgical precision for single teeth or full-arch restorations.',
    feeGuide: 'Consultations from £65',
    features: ['CBCT 3D bone mapping', 'Single & multiple implants', 'All-on-4 full arch restoration'],
    ctaText: 'Book Implant Consult',
    icon: 'tooth'
  },
  {
    id: 'orthodontics',
    title: 'Invisalign® Clear Aligners',
    category: 'Orthodontics',
    description: 'Discreetly straighten crooked or crowded teeth with custom transparent aligners. Preview your finished smile before you begin with 3D iTero simulation.',
    feeGuide: 'From £1,800 (Finance available)',
    features: ['Diamond Apex Provider', '3D digital outcome simulator', 'Removable & wire-free'],
    ctaText: 'Preview Your Smile',
    icon: 'aligner'
  },
  {
    id: 'periodontics',
    title: 'Periodontal & Laser Gum Therapy',
    category: 'Gum Health',
    description: 'Specialist-led gum treatment addressing gingivitis, bleeding gums, and periodontal pockets using minimally invasive laser therapy and deep disinfection.',
    feeGuide: 'From £140',
    features: ['Laser gum therapy', 'Deep pocket decontamination', 'Systemic wellness focus'],
    ctaText: 'Protect Your Gums',
    icon: 'heart'
  },
  {
    id: 'emergency',
    title: 'Same-Day Emergency Dental Relief',
    category: 'Urgent Care',
    description: 'Immediate pain relief for acute toothache, knocked-out or chipped teeth, lost crowns, or dental abscesses. Guaranteed daily emergency appointment slots.',
    feeGuide: 'Emergency triage from £85',
    features: ['Same-day appointments', 'Instant diagnosis & pain relief', 'Direct clinician line'],
    ctaText: 'Emergency Booking',
    icon: 'bell'
  }
];

// Clinical Diagnostics & Modern Technology
const technologies = [
  {
    title: 'iTero® 5D Plus Intraoral 3D Scanners',
    subtitle: 'Zero Putty, Micron Precision',
    description: 'Goodbye to messy silicone impression trays. Our optical wand takes 6,000 optical frames per second to render an accurate 3D model of your teeth in under 3 minutes.',
    badge: 'Digital Scanning'
  },
  {
    title: 'Ultra-Low Dose 3D CBCT Radiography',
    subtitle: '80% Lower Radiation',
    description: 'High-definition 3D volumetric bone and nerve scans provide our surgeons with sub-millimeter anatomical accuracy while exposing you to significantly less radiation.',
    badge: '3D Diagnostics'
  },
  {
    title: 'EMS Airflow® Guided Biofilm Therapy',
    subtitle: 'Gentle Spa-Like Cleaning',
    description: 'Swiss-engineered warm water and fine erythritol powder gently dissolve tough staining from coffee, tea, and tobacco without scraping or damaging tooth enamel.',
    badge: 'Comfort Hygiene'
  },
  {
    title: 'AI-Assisted Dental Radiographic Analysis',
    subtitle: 'Microscopic Cavity Detection',
    description: 'Second Opinion® artificial intelligence reviews your dental radiographs alongside our dentists to pinpoint microscopic enamel demineralization early.',
    badge: 'Predictive Care'
  }
];

// Practice Highlights & Patient Trust Metrics
const statistics = [
  { value: '15+', label: 'Years on Harley Street' },
  { value: '4.9★', label: 'Google Rating (500+ Reviews)' },
  { value: '12,500+', label: 'Smiles Transformed' },
  { value: '100%', label: 'GDC & CQC Registered' }
];

// Patient Testimonials
const reviews = [
  {
    quote: "I avoided dentists for over 10 years due to severe phobia. The calm, non-judgmental approach at Apex completely transformed my experience. The treatment was painless and the sedation options made everything effortless.",
    author: 'Clara Weatherford',
    location: 'Marylebone, London',
    treatment: 'Comprehensive Restoration & Hygiene',
    verified: true
  },
  {
    quote: "Had my Invisalign and composite edge bonding done with Dr. Vance. The iTero scan predicted the outcome perfectly and my teeth look naturally flawless. Plus, 0% finance made the process so straightforward.",
    author: 'James Kensington',
    location: 'Mayfair, London',
    treatment: 'Invisalign & Composite Bonding',
    verified: true
  },
  {
    quote: "Woke up on a Sunday morning with unbearable molar pain from an infection. Called Apex and was seen within 90 minutes. They relieved the pain immediately and saved my tooth. Cannot recommend them highly enough.",
    author: 'Dr. Priya Sharma',
    location: 'Fitzrovia, London',
    treatment: 'Same-Day Emergency Triage',
    verified: true
  }
];
---

<BaseLayout
  title="Private Dentist in Harley Street, London"
  description="Apex Dental Studio is a leading private dental practice on Harley Street, London. Modern, gentle dental care: hygiene cleanings, composite bonding, Invisalign, and dental implants."
>
  <!-- Hero Section with High-Performance Photography -->
  <section class="relative overflow-hidden bg-gradient-to-b from-cyan-50/70 via-white to-slate-50 py-16 sm:py-24 lg:py-28" aria-labelledby="hero-title">
    <!-- Ambient Backdrop Illumination -->
    <div class="absolute -top-40 left-1/2 -z-10 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-cyan-200/40 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/3 -right-24 -z-10 h-[400px] w-[400px] rounded-full bg-sky-200/30 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <!-- Hero Copy -->
        <div class="lg:col-span-7">
          <!-- Location Badge -->
          <div class="inline-flex items-center gap-2 rounded-full bg-cyan-100/80 px-4 py-1.5 text-xs font-bold text-cyan-900 border border-cyan-200/80 mb-6">
            <span class="inline-block h-2 w-2 rounded-full bg-cyan-600"></span>
            <span>42 Harley Street • Central London Private Dentistry</span>
          </div>

          <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 leading-[1.12]">
            Modern, gentle dental care designed around <span class="bg-gradient-to-r from-cyan-600 via-sky-600 to-teal-600 bg-clip-text text-transparent">your comfort</span>.
          </h1>

          <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl">
            Experience anxiety-free private dentistry in central London. From Airflow stain removal and composite bonding to 3D guided implants and Invisalign clear aligners—with transparent fees and zero waiting.
          </p>

          <!-- Dual Call to Actions -->
          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="#appointment"
              class="inline-flex items-center justify-center rounded-xl bg-cyan-600 px-7 py-4 text-base font-bold text-white shadow-lg shadow-cyan-600/25 hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all active:scale-[0.98]"
              id="hero-book-cta"
            >
              Book an Appointment
              <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
            <a
              href="tel:02079460912"
              class="inline-flex items-center justify-center rounded-xl bg-white px-7 py-4 text-base font-bold text-rose-600 border border-rose-200 shadow-xs hover:bg-rose-50 hover:border-rose-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-500 transition-all"
              id="hero-emergency-cta"
            >
              <svg class="mr-2 h-5 w-5 text-rose-600 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              Emergency Care: 020 7946 0912
            </a>
          </div>

          <!-- Value Propositions Checklist -->
          <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-slate-200/90 pt-8 text-xs font-semibold text-slate-700">
            <div class="flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold">✓</span>
              <span>Transparent UK Private Fees</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold">✓</span>
              <span>0% APR Patient Financing</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold">✓</span>
              <span>Anxious Patient Sedation Menu</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual: Real Dental Photography with Overlay Badges -->
        <div class="lg:col-span-5">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Decorative Backing Glow -->
            <div class="absolute -inset-2 rounded-3xl bg-gradient-to-r from-cyan-600 to-sky-600 opacity-20 blur-xl"></div>

            <div class="relative overflow-hidden rounded-3xl bg-white p-3 shadow-2xl border border-slate-200/80">
              <Image
                src={heroImage}
                alt="Modern private dental surgery treatment suite and friendly consultation on Harley Street London"
                class="w-full h-80 sm:h-96 object-cover rounded-2xl"
                widths={[400, 800, 1200]}
                sizes="(max-width: 768px) 100vw, 50vw"
                format="webp"
                quality={85}
                loading="eager"
              />

              <!-- Floating Doctor Credential Badge -->
              <div class="absolute bottom-6 left-6 right-6 rounded-2xl bg-white/95 backdrop-blur-md p-4 shadow-xl border border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-600 text-white font-black text-sm shadow-md">
                    AD
                  </div>
                  <div>
                    <h2 class="text-sm font-bold text-slate-900 leading-tight">Dr. Elena Vance, BDS</h2>
                    <p class="text-[11px] text-slate-500">Lead Clinician • GDC Reg: 198421</p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700 border border-emerald-200/60">
                    ★ 4.9
                  </span>
                  <span class="block text-[10px] text-slate-400 mt-0.5">500+ Reviews</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Statistics & Practice Metric Banner -->
  <section class="bg-slate-950 py-10 text-white border-y border-slate-800" aria-label="Clinical Metrics">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4 text-center">
        {statistics.map((stat) => (
          <div class="flex flex-col">
            <span class="text-3xl sm:text-4xl font-extrabold text-cyan-400 tracking-tight">{stat.value}</span>
            <span class="mt-1 text-xs sm:text-sm font-medium text-slate-400">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinical Specialties Grid -->
  <section id="services" class="py-20 lg:py-28 bg-white" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-cyan-600">Comprehensive Clinical Services</span>
        <h2 id="services-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          World-class dental treatments in central London
        </h2>
        <p class="mt-4 text-base text-slate-600">
          From preventative hygiene to advanced full-mouth rehabilitations, our Harley Street team provides ethical, patient-centered care.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {specialties.map((item) => (
          <article class="group relative flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-8 shadow-xs hover:border-cyan-300 hover:shadow-xl hover:shadow-cyan-600/5 transition-all duration-300">
            <div>
              <!-- Header Badges -->
              <div class="flex items-center justify-between mb-5">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-50 text-cyan-600 group-hover:bg-cyan-600 group-hover:text-white transition-colors duration-200">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2C8 2 6 4 6 8c0 3.5 1.5 6 2 9 .4 2.5 1.5 4 4 4s3.6-1.5 4-4c.5-3 2-5.5 2-9 0-4-2-6-6-6Z" />
                    <path d="M9 10c1.5 1 4.5 1 6 0" />
                  </svg>
                </span>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                  {item.category}
                </span>
              </div>

              <!-- Title & Description -->
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-cyan-700 transition-colors">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">
                {item.description}
              </p>

              <!-- Treatment Checklist -->
              <ul class="mt-5 space-y-2 text-xs font-medium text-slate-600">
                {item.features.map((feat) => (
                  <li class="flex items-center gap-2">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan-600 shrink-0"></span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Pricing & Action Footer -->
            <div class="mt-8 pt-5 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Fee Guide</span>
                <span class="text-sm font-bold text-slate-900">{item.feeGuide}</span>
              </div>
              <a
                href="#appointment"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-cyan-700 hover:text-cyan-800 transition-colors focus:outline-none focus-visible:underline"
                aria-label={`Enquire about ${item.title}`}
              >
                <span>{item.ctaText}</span>
                <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Modern Diagnostic Technology Section (with Tech Photography) -->
  <section id="technology" class="py-20 lg:py-24 bg-slate-50 border-t border-slate-200/90" aria-labelledby="technology-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Tech Description & Feature Grid -->
        <div class="lg:col-span-7">
          <span class="text-xs font-bold uppercase tracking-widest text-cyan-600">Precision Diagnostics</span>
          <h2 id="technology-heading" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            Modern technology that makes appointments faster and gentler
          </h2>
          <p class="mt-3 text-base text-slate-600 leading-relaxed">
            We invest in advanced optical and radiographic tools to eliminate discomfort, increase diagnostic accuracy, and reduce chair time.
          </p>

          <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
            {technologies.map((tech) => (
              <div class="rounded-2xl bg-white p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="inline-flex items-center rounded-lg bg-cyan-50 px-2.5 py-0.5 text-xs font-bold text-cyan-800 border border-cyan-100">
                      {tech.badge}
                    </span>
                    <span class="text-[11px] font-semibold text-slate-400">{tech.subtitle}</span>
                  </div>
                  <h3 class="text-base font-bold text-slate-900">{tech.title}</h3>
                  <p class="mt-2 text-xs leading-relaxed text-slate-600">{tech.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Tech Photography Card -->
        <div class="lg:col-span-5">
          <div class="overflow-hidden rounded-3xl bg-white p-3 shadow-xl border border-slate-200/90">
            <Image
              src={techImage}
              alt="Advanced digital dental diagnostics, 3D CBCT imaging, and modern operatory equipment"
              class="w-full h-80 sm:h-96 object-cover rounded-2xl"
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 40vw"
              format="webp"
              quality={85}
              loading="lazy"
            />
            <div class="p-4 text-center">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200/60">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                Ultra-Low Radiation &amp; 3D Digital Impressions
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About / Nervous Patient Care Section (with Clinic Interior Photography) -->
  <section id="about" class="py-20 bg-white" aria-labelledby="about-practice-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <span class="text-xs font-bold uppercase tracking-widest text-cyan-600">Patient-Centered Dentistry</span>
          <h2 id="about-practice-heading" class="mt-2 text-3xl sm:text-4xl font-extrabold text-slate-900">
            A calm, unhurried approach for anxious patients
          </h2>
          <p class="mt-4 text-base text-slate-600 leading-relaxed">
            Over half of UK adults feel nervous about seeing a dentist. At Apex Dental Studio, our philosophy is anchored in patient empowerment. You are always in control of your treatment. We explain every step beforehand and offer stop-signals so we pause whenever you need.
          </p>

          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-cyan-100 text-cyan-700 font-bold text-sm">
                1
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-900">Comfort Menu Available</h3>
                <p class="text-xs text-slate-600 mt-0.5">Choose your entertainment, request warm neck rolls, adjust operatory lighting, or listen to noise-canceling headphones.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-cyan-100 text-cyan-700 font-bold text-sm">
                2
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-900">Conscious Sedation Options</h3>
                <p class="text-xs text-slate-600 mt-0.5">For complex surgical treatments or severe dental phobia, our accredited sedation doctors provide intravenous (IV) conscious sedation.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-cyan-100 text-cyan-700 font-bold text-sm">
                3
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-900">Zero Pressure Consultations</h3>
                <p class="text-xs text-slate-600 mt-0.5">We provide transparent written quotes detailing all treatment alternatives, prognosis, and fee schedules with no sales pressure.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Clinic Interior Photography -->
        <div class="lg:col-span-6">
          <div class="overflow-hidden rounded-3xl bg-slate-100 p-3 shadow-xl border border-slate-200">
            <Image
              src={clinicImage}
              alt="Bright, modern, relaxing private dental practice operatory interior on Harley Street London"
              class="w-full h-80 sm:h-96 object-cover rounded-2xl"
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 50vw"
              format="webp"
              quality={85}
              loading="lazy"
            />
            <div class="mt-4 p-4 rounded-2xl bg-white border border-slate-200/80">
              <p class="text-xs font-bold text-slate-900">42 Harley Street Treatment Suites</p>
              <p class="text-xs text-slate-500 mt-0.5">Architecturally designed for acoustical serenity, natural light, and hospital-grade HEPA 14 air purity.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Patient Testimonials & Smile Results Section (with Smile Photography) -->
  <section id="testimonials" class="py-20 bg-slate-900 text-white" aria-labelledby="reviews-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16">
        <div class="lg:col-span-7">
          <span class="text-xs font-bold uppercase tracking-widest text-cyan-400">Verified Patient Feedback</span>
          <h2 id="reviews-heading" class="mt-2 text-3xl font-extrabold sm:text-4xl">
            Real stories and natural smile transformations
          </h2>
          <p class="mt-3 text-base text-slate-400">
            Consistently rated 5 stars for gentle technique, artistic precision, and transparent pricing.
          </p>
        </div>
        
        <!-- Smile Results Photography Showcase -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative overflow-hidden rounded-3xl bg-slate-800 p-2.5 border border-slate-700/80 shadow-2xl max-w-sm">
            <Image
              src={smileImage}
              alt="Happy smiling patient with healthy confident teeth after cosmetic bonding and teeth whitening"
              class="w-full h-56 object-cover rounded-2xl"
              widths={[400, 600]}
              sizes="(max-width: 768px) 100vw, 30vw"
              format="webp"
              quality={85}
              loading="lazy"
            />
            <div class="p-3 text-center">
              <span class="text-xs font-bold text-cyan-300">Natural Aesthetic Results</span>
              <p class="text-[11px] text-slate-400 mt-0.5">Bespoke cosmetic bonding &amp; Invisalign orthodontic alignment</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {reviews.map((rev) => (
          <div class="rounded-3xl bg-slate-800/90 p-8 border border-slate-700/80 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1 text-amber-400 text-base mb-4" aria-label="5 out of 5 stars">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>
              <blockquote class="text-sm leading-relaxed text-slate-300 italic">
                "{rev.quote}"
              </blockquote>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-700">
              <p class="text-sm font-bold text-white">{rev.author}</p>
              <p class="text-xs text-slate-400">{rev.location}</p>
              <span class="mt-2 inline-block rounded-md bg-cyan-950/80 px-2 py-0.5 text-[11px] font-semibold text-cyan-300 border border-cyan-800/50">
                {rev.treatment}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Appointment Inquiry & Contact Section -->
  <section id="appointment" class="py-20 lg:py-24 bg-slate-50 border-t border-slate-200/90" aria-labelledby="booking-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Clinic Information & Map Details -->
        <div class="lg:col-span-5" id="contact">
          <span class="text-xs font-bold uppercase tracking-widest text-cyan-600">Get In Touch</span>
          <h2 id="booking-heading" class="mt-2 text-3xl font-extrabold text-slate-900">
            Visit Apex Dental Studio on Harley Street
          </h2>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            Ready to experience gentle, modern dentistry? Submit your appointment inquiry or call our reception team directly.
          </p>

          <!-- Contact Details Cards -->
          <div class="mt-8 space-y-4">
            <div class="rounded-2xl bg-white p-5 border border-slate-200/90 shadow-xs">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Clinic Address</p>
              <p class="text-sm font-semibold text-slate-900 mt-1">42 Harley Street, Marylebone, London, W1G 9QD</p>
              <p class="text-xs text-slate-500 mt-0.5">Underground: Oxford Circus (Bakerloo/Central/Victoria), Bond Street (Elizabeth Line), Regent's Park.</p>
            </div>

            <div class="rounded-2xl bg-white p-5 border border-slate-200/90 shadow-xs">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Direct Telephone Desk</p>
              <p class="text-base font-bold text-cyan-700 mt-1">
                <a href="tel:02079460912" class="hover:underline">020 7946 0912</a>
              </p>
              <p class="text-xs text-slate-500 mt-0.5">Emergency Triage Line: <a href="tel:02079460999" class="text-rose-600 font-semibold hover:underline">020 7946 0999</a></p>
            </div>

            <div class="rounded-2xl bg-white p-5 border border-slate-200/90 shadow-xs">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Practice Opening Hours</p>
              <div class="mt-2 space-y-1 text-xs text-slate-600">
                <div class="flex justify-between">
                  <span>Monday – Thursday:</span>
                  <span class="font-medium text-slate-900">08:30 – 18:00</span>
                </div>
                <div class="flex justify-between">
                  <span>Friday:</span>
                  <span class="font-medium text-slate-900">08:30 – 17:00</span>
                </div>
                <div class="flex justify-between">
                  <span>Saturday:</span>
                  <span class="font-medium text-slate-900">09:00 – 14:00</span>
                </div>
                <div class="flex justify-between text-rose-600 font-semibold">
                  <span>Sunday:</span>
                  <span>Emergency On-Call</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Semantic Zero-JS Appointment Form -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl bg-white p-8 sm:p-10 shadow-xl border border-slate-200/90">
            <h3 class="text-xl font-bold text-slate-900">Request an Appointment</h3>
            <p class="text-xs text-slate-500 mt-1 mb-6">
              Complete the details below. Our treatment coordinator will phone or email you within 2 business hours to confirm your preferred time.
            </p>

            <form
              action="/api/appointment"
              method="POST"
              class="space-y-5"
              id="appointment-form"
            >
              <!-- Name & Email -->
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="form-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Full Name *</label>
                  <input
                    type="text"
                    id="form-name"
                    name="fullName"
                    required
                    autocomplete="name"
                    placeholder="e.g. Sarah Jenkins"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-cyan-600 focus:ring-2 focus:ring-cyan-200 outline-none transition-all"
                  />
                </div>
                <div>
                  <label for="form-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Email Address *</label>
                  <input
                    type="email"
                    id="form-email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="sarah.jenkins@example.co.uk"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-cyan-600 focus:ring-2 focus:ring-cyan-200 outline-none transition-all"
                  />
                </div>
              </div>

              <!-- Phone & Patient Status -->
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="form-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Telephone Number *</label>
                  <input
                    type="tel"
                    id="form-phone"
                    name="phone"
                    required
                    autocomplete="tel"
                    placeholder="e.g. 07123 456789 or 020 7946 0912"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-cyan-600 focus:ring-2 focus:ring-cyan-200 outline-none transition-all"
                  />
                </div>
                <div>
                  <label for="form-status" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Patient Status</label>
                  <select
                    id="form-status"
                    name="patientStatus"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 bg-white focus:border-cyan-600 focus:ring-2 focus:ring-cyan-200 outline-none transition-all"
                  >
                    <option value="new">New Patient (First Visit)</option>
                    <option value="registered">Registered Patient</option>
                  </select>
                </div>
              </div>

              <!-- Preferred Treatment & Time Slot -->
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="form-treatment" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Preferred Treatment *</label>
                  <select
                    id="form-treatment"
                    name="treatment"
                    required
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 bg-white focus:border-cyan-600 focus:ring-2 focus:ring-cyan-200 outline-none transition-all"
                  >
                    <option value="routine-checkup">Comprehensive Exam &amp; Airflow Hygiene</option>
                    <option value="invisalign">Invisalign® Clear Aligners</option>
                    <option value="cosmetic-bonding">Composite Edge Bonding / Smile Design</option>
                    <option value="dental-implants">Dental Implants / Tooth Replacement</option>
                    <option value="teeth-whitening">Enlighten / Boutique Whitening</option>
                    <option value="emergency-pain">Same-Day Emergency Relief</option>
                    <option value="nervous-consultation">Anxious Patient Consultation (Sedation)</option>
                  </select>
                </div>
                <div>
                  <label for="form-time" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Preferred Time Slot</label>
                  <select
                    id="form-time"
                    name="preferredTime"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 bg-white focus:border-cyan-600 focus:ring-2 focus:ring-cyan-200 outline-none transition-all"
                  >
                    <option value="morning">Morning (08:30 – 12:00)</option>
                    <option value="afternoon">Afternoon (12:00 – 16:00)</option>
                    <option value="late-afternoon">Late Afternoon (16:00 – 18:00)</option>
                    <option value="saturday">Saturday Morning (09:00 – 14:00)</option>
                    <option value="emergency-asap">Emergency — As soon as possible</option>
                  </select>
                </div>
              </div>

              <!-- Message / Additional Concerns -->
              <div>
                <label for="form-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Specific Dental Concerns / Notes (Optional)</label>
                <textarea
                  id="form-message"
                  name="message"
                  rows="3"
                  placeholder="Tell us if you have any dental pain, nervousness, or specific aesthetic goals..."
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-cyan-600 focus:ring-2 focus:ring-cyan-200 outline-none transition-all"
                ></textarea>
              </div>

              <!-- Consent & Data Protection -->
              <div class="flex items-start gap-3 pt-2">
                <input
                  type="checkbox"
                  id="form-consent"
                  name="consent"
                  required
                  class="mt-1 h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500"
                />
                <label for="form-consent" class="text-xs text-slate-600 leading-normal">
                  I agree to Apex Dental Studio processing my information to contact me regarding my appointment inquiry in compliance with UK GDPR and the <a href="/#contact" class="text-cyan-700 underline">Privacy Policy</a>.
                </label>
              </div>

              <!-- Submit Button -->
              <div class="pt-4 flex items-center justify-between">
                <span class="text-xs text-slate-400">🔒 Confidential medical data protection</span>
                <button
                  type="submit"
                  id="submit-inquiry-btn"
                  class="inline-flex items-center justify-center rounded-xl bg-cyan-600 px-8 py-3.5 text-sm font-bold text-white shadow-md hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all active:scale-[0.98]"
                >
                  Submit Appointment Inquiry
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
