---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
}

const {
  title,
  description = "Apex Dental Studio is an award-winning private dental practice on Harley Street, London. Offering gentle preventive dentistry, Invisalign clear aligners, bespoke composite bonding, and 3D dental implants.",
  canonicalUrl = Astro.url.href,
  ogType = "website",
} = Astro.props;

// Schema.org structured data for Dentist and LocalBusiness (UK compliance & local SEO)
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Dentist", "LocalBusiness", "MedicalBusiness"],
      "@id": `${canonicalUrl}#dentist`,
      "name": "Apex Dental Studio",
      "legalName": "Apex Dental Studio Ltd",
      "url": canonicalUrl,
      "logo": new URL("/favicon.svg", canonicalUrl).href,
      "image": new URL("/images/og-dental-preview.jpg", canonicalUrl).href,
      "description": description,
      "telephone": "+44-20-7946-0912",
      "email": "reception@apexdentalstudio.co.uk",
      "priceRange": "££",
      "currenciesAccepted": "GBP",
      "paymentAccepted": "Cash, Credit Card, Debit Card, Direct Debit, Patient Financing",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "42 Harley Street",
        "addressLocality": "Marylebone",
        "addressRegion": "Greater London",
        "postalCode": "W1G 9QD",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 51.5186,
        "longitude": -0.1472
      },
      "hasMap": "https://maps.google.com/?q=51.5186,-0.1472",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
          "opens": "08:30",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Friday",
          "opens": "08:30",
          "closes": "17:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "14:00"
        }
      ],
      "medicalSpecialty": "Dentistry",
      "isAcceptingNewPatients": true,
      "availableService": [
        { "@type": "MedicalProcedure", "name": "Comprehensive Dental Examination & Diagnostics" },
        { "@type": "MedicalProcedure", "name": "Guided Biofilm Airflow Dental Hygiene" },
        { "@type": "MedicalProcedure", "name": "Invisalign Clear Aligner Orthodontics" },
        { "@type": "MedicalProcedure", "name": "Dental Implants & All-on-4 Reconstructions" },
        { "@type": "MedicalProcedure", "name": "Cosmetic Bonding & Porcelain Veneers" },
        { "@type": "MedicalProcedure", "name": "Same-Day Emergency Dental Triage" }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth antialiased selection:bg-cyan-600 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary SEO Metadata -->
    <title>{title} | Apex Dental Studio London</title>
    <meta name="title" content={`${title} | Apex Dental Studio London`} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0891b2" />
    <meta name="format-detection" content="telephone=yes" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Apex Dental Studio" />
    <meta property="og:title" content={`${title} | Apex Dental Studio London`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og-dental-preview.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | Apex Dental Studio London`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/og-dental-preview.jpg" />

    <!-- Structured Data (JSON-LD LocalBusiness & Dentist Schema) -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-800">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-xl focus:bg-cyan-700 focus:px-5 focus:py-3 focus:text-white focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-cyan-400"
    >
      Skip to main content
    </a>

    <!-- Top Announcement & Emergency Bar -->
    <aside aria-label="Clinic announcement & urgent contact" class="bg-slate-950 text-xs font-medium text-slate-300 py-2.5 px-4 border-b border-slate-800">
      <div class="mx-auto max-w-7xl flex flex-wrap items-center justify-between gap-2.5">
        <div class="flex items-center gap-2 mx-auto sm:mx-0">
          <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
          <span>42 Harley Street, London W1G 9QD • Welcoming New Private Patients</span>
        </div>
        <div class="flex items-center gap-5 mx-auto sm:mx-0 text-xs">
          <span class="hidden md:inline text-slate-400">Mon–Fri: 08:30–18:00 | Sat: 09:00–14:00</span>
          <div class="flex items-center gap-3">
            <span class="text-slate-600 hidden sm:inline" aria-hidden="true">|</span>
            <a href="tel:02079460912" class="text-cyan-400 hover:text-cyan-300 font-semibold flex items-center gap-1.5 transition-colors">
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              <span>020 7946 0912</span>
            </a>
            <span class="text-slate-600" aria-hidden="true">•</span>
            <a href="/#appointment" class="text-rose-400 hover:text-rose-300 font-semibold underline underline-offset-2">
              Emergency Care
            </a>
          </div>
        </div>
      </div>
    </aside>

    <!-- Semantic Header & Navigation -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-xs">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 py-3.5 relative">
        <!-- Clinic Logo / Brand -->
        <a href="/" class="group flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600 rounded-xl" id="header-brand-logo">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-600 to-sky-700 text-white shadow-md shadow-cyan-600/20 group-hover:scale-105 transition-transform duration-200">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2C8 2 6 4 6 8c0 3.5 1.5 6 2 9 .4 2.5 1.5 4 4 4s3.6-1.5 4-4c.5-3 2-5.5 2-9 0-4-2-6-6-6Z" />
              <path d="M9 10c1.5 1 4.5 1 6 0" />
            </svg>
          </span>
          <div class="flex flex-col">
            <span class="text-lg font-extrabold tracking-tight text-slate-900 group-hover:text-cyan-700 transition-colors">Apex Dental Studio</span>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-cyan-700 -mt-1">Harley Street • London</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-8">
          <a href="/#services" class="text-sm font-semibold text-slate-700 hover:text-cyan-600 transition-colors">Treatments</a>
          <a href="/#about" class="text-sm font-semibold text-slate-700 hover:text-cyan-600 transition-colors">About Us</a>
          <a href="/#technology" class="text-sm font-semibold text-slate-700 hover:text-cyan-600 transition-colors">Digital Clinic</a>
          <a href="/#testimonials" class="text-sm font-semibold text-slate-700 hover:text-cyan-600 transition-colors">Patient Reviews</a>
          <a href="/#contact" class="text-sm font-semibold text-slate-700 hover:text-cyan-600 transition-colors">Contact</a>
        </nav>

        <!-- Desktop Action Buttons -->
        <div class="hidden sm:flex items-center gap-3">
          <a
            href="tel:02079460912"
            class="hidden md:inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-semibold text-slate-700 shadow-xs hover:border-cyan-300 hover:text-cyan-700 transition-all"
            id="header-phone-button"
          >
            <svg class="h-4 w-4 text-cyan-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>020 7946 0912</span>
          </a>
          <a
            href="/#appointment"
            class="inline-flex items-center justify-center rounded-xl bg-cyan-600 px-4 py-2 text-sm font-bold text-white shadow-md shadow-cyan-600/20 hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all active:scale-[0.98]"
            id="header-book-button"
          >
            Book Appointment
          </a>
        </div>

        <!-- Mobile Navigation Menu (Pure HTML/CSS via <details>, Zero JS) -->
        <details class="lg:hidden group">
          <summary
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-xs hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-cyan-500 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
            aria-label="Toggle navigation menu"
            id="mobile-menu-toggle"
          >
            <!-- Hamburger Icon (visible when closed) -->
            <svg class="h-5 w-5 block group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
            <!-- Close Icon (visible when open) -->
            <svg class="h-5 w-5 hidden group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </summary>

          <!-- Dropdown Navigation Card -->
          <nav aria-label="Mobile Navigation Drawer" class="absolute left-4 right-4 top-full mt-2 rounded-2xl border border-slate-200 bg-white p-5 shadow-2xl z-50 flex flex-col gap-2">
            <a href="/#services" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-cyan-50 hover:text-cyan-700 transition-colors">
              Treatments &amp; Services
            </a>
            <a href="/#about" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-cyan-50 hover:text-cyan-700 transition-colors">
              About Our Practice
            </a>
            <a href="/#technology" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-cyan-50 hover:text-cyan-700 transition-colors">
              Modern Digital Technology
            </a>
            <a href="/#testimonials" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-cyan-50 hover:text-cyan-700 transition-colors">
              Patient Testimonials
            </a>
            <a href="/#contact" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-cyan-50 hover:text-cyan-700 transition-colors">
              Location &amp; Clinic Hours
            </a>

            <div class="mt-2 pt-3 border-t border-slate-100 flex flex-col gap-2.5">
              <a
                href="tel:02079460912"
                class="flex items-center justify-center gap-2 rounded-xl bg-slate-100 py-3 text-sm font-bold text-slate-800 hover:bg-slate-200 transition-colors"
              >
                <svg class="h-4 w-4 text-cyan-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                Call: 020 7946 0912
              </a>
              <a
                href="/#appointment"
                class="flex items-center justify-center rounded-xl bg-cyan-600 py-3 text-sm font-bold text-white shadow-md hover:bg-cyan-500 transition-colors"
              >
                Book Appointment
              </a>
            </div>
          </nav>
        </details>
      </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Semantic Footer with UK Regulatory & Legal Information -->
    <footer class="bg-slate-950 text-slate-300 border-t border-slate-800/90" role="contentinfo">
      <!-- Upper Footer Grid -->
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
          <!-- Column 1: Brand & Clinic Details -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-500 to-sky-600 text-white shadow-md">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2C8 2 6 4 6 8c0 3.5 1.5 6 2 9 .4 2.5 1.5 4 4 4s3.6-1.5 4-4c.5-3 2-5.5 2-9 0-4-2-6-6-6Z" />
                  <path d="M9 10c1.5 1 4.5 1 6 0" />
                </svg>
              </span>
              <span class="text-xl font-extrabold text-white tracking-tight">Apex Dental Studio</span>
            </div>
            <p class="text-sm leading-relaxed text-slate-400 mb-5">
              Providing patient-focused private dental care in the heart of London. Dedicated to calm, painless dentistry using modern digital imaging and biocompatible restorative materials.
            </p>
            <div class="inline-flex items-center gap-2 rounded-lg bg-slate-900 border border-slate-800 px-3 py-1.5 text-xs text-emerald-400 font-medium">
              <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
              Same-Day Emergency Relief Reserved Daily
            </div>
          </div>

          <!-- Column 2: Clinical Specialties -->
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Clinical Treatments</h2>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Routine Examinations &amp; Hygiene</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Airflow Guided Biofilm Therapy</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Invisalign Clear Aligners</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Composite Bonding &amp; Veneers</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Dental Implants &amp; Restorations</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Emergency Toothache Relief</a></li>
            </ul>
          </div>

          <!-- Column 3: Clinic Opening Hours -->
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Opening Hours</h2>
            <ul class="space-y-2 text-sm text-slate-400">
              <li class="flex justify-between py-1 border-b border-slate-900">
                <span>Monday – Thursday</span>
                <span class="font-medium text-white">08:30 – 18:00</span>
              </li>
              <li class="flex justify-between py-1 border-b border-slate-900">
                <span>Friday</span>
                <span class="font-medium text-white">08:30 – 17:00</span>
              </li>
              <li class="flex justify-between py-1 border-b border-slate-900">
                <span>Saturday</span>
                <span class="font-medium text-white">09:00 – 14:00</span>
              </li>
              <li class="flex justify-between py-1">
                <span>Sunday &amp; Bank Holidays</span>
                <span class="text-rose-400 font-medium">Emergency Triage</span>
              </li>
            </ul>
          </div>

          <!-- Column 4: Location & Contact -->
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Practice Location</h2>
            <address class="not-italic text-sm text-slate-400 space-y-2">
              <p class="leading-relaxed">
                <strong class="text-white font-semibold">Apex Dental Studio</strong><br />
                42 Harley Street, Marylebone<br />
                London, W1G 9QD, United Kingdom
              </p>
              <div class="pt-2 space-y-1">
                <p>
                  <span class="text-xs text-slate-500 block">General Enquiries:</span>
                  <a href="tel:02079460912" class="text-cyan-400 font-semibold hover:underline">020 7946 0912</a>
                </p>
                <p>
                  <span class="text-xs text-slate-500 block">Email Desk:</span>
                  <a href="mailto:reception@apexdentalstudio.co.uk" class="text-slate-300 hover:text-white transition-colors">
                    reception@apexdentalstudio.co.uk
                  </a>
                </p>
              </div>
            </address>
          </div>
        </div>

        <!-- UK GDC & Regulatory Compliance Notice -->
        <div class="mt-12 rounded-2xl bg-slate-900/90 border border-slate-800 p-6 text-xs text-slate-400 leading-relaxed">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-3 pb-3 border-b border-slate-800">
            <span class="font-bold uppercase tracking-wider text-slate-200">Regulatory Compliance Notice (United Kingdom)</span>
            <div class="flex items-center gap-4 text-slate-300 font-medium">
              <span>CQC Provider ID: 1-102938475</span>
              <span>•</span>
              <span>GDC Practice Reg: 248910</span>
            </div>
          </div>
          <p>
            Apex Dental Studio is fully regulated by the <strong class="text-slate-300">Care Quality Commission (CQC)</strong>. All practicing dentists, dental hygienists, and dental care professionals at this clinic are registered with the <strong class="text-slate-300">General Dental Council (GDC)</strong> and adhere to the <em class="not-italic text-slate-300">GDC Standards for the Dental Team</em>. For more information regarding our professional regulatory body, visit the <a href="https://www.gdc-uk.org" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:underline">General Dental Council website</a> (GDC, 37 Wimpole Street, London, W1G 8DQ).
          </p>
        </div>

        <!-- Sub-footer Legal Links -->
        <div class="mt-10 pt-8 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} Apex Dental Studio Ltd. All rights reserved. Zero-JavaScript SSG.</p>
          <div class="flex flex-wrap items-center gap-6">
            <a href="/#contact" class="hover:text-slate-300 transition-colors">Privacy Notice (UK GDPR)</a>
            <a href="/#contact" class="hover:text-slate-300 transition-colors">Cookie Policy</a>
            <a href="/#contact" class="hover:text-slate-300 transition-colors">Complaints Procedure</a>
            <a href="/#contact" class="hover:text-slate-300 transition-colors">Accessibility Statement</a>
            <a href="/404" class="hover:text-slate-300 transition-colors">404 Error Test</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
