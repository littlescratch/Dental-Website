---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "Apex Dental Studio offers comprehensive general, cosmetic, and restorative dentistry with cutting-edge technology and compassionate care.",
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased selection:bg-cyan-500 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary Meta Tags -->
    <title>{title} | Apex Dental Studio</title>
    <meta name="title" content={`${title} | Apex Dental Studio`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0284c7" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Apex Dental Studio`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og-dental-preview.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | Apex Dental Studio`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/images/og-dental-preview.jpg" />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-800">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-cyan-600 focus:px-4 focus:py-2 focus:text-white focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-cyan-400"
    >
      Skip to main content
    </a>

    <!-- Top Announcement Bar -->
    <aside aria-label="Announcement" class="bg-gradient-to-r from-cyan-900 via-sky-900 to-slate-900 text-xs font-medium text-cyan-100 py-2 px-4 text-center border-b border-cyan-800/50">
      <div class="mx-auto max-w-7xl flex flex-wrap items-center justify-between gap-2">
        <p class="flex items-center gap-1.5 mx-auto sm:mx-0">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
          <span>Now welcoming new patients with gentle, state-of-the-art care</span>
        </p>
        <div class="hidden sm:flex items-center gap-4 text-xs mx-auto sm:mx-0">
          <span>Mon–Fri: 8:00 AM – 6:00 PM</span>
          <span class="text-cyan-400" aria-hidden="true">•</span>
          <a href="tel:5553214321" class="hover:text-white underline underline-offset-2">Emergency: (555) 321-4321</a>
        </div>
      </div>
    </aside>

    <!-- Header & Navigation -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 py-3.5">
        <!-- Logo -->
        <a href="/" class="group flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600 rounded-lg" id="site-logo">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500 to-sky-600 text-white shadow-md shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-200">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2C8 2 6 4 6 8c0 3.5 1.5 6 2 9 .4 2.5 1.5 4 4 4s3.6-1.5 4-4c.5-3 2-5.5 2-9 0-4-2-6-6-6Z" />
              <path d="M9 10c1.5 1 4.5 1 6 0" />
            </svg>
          </span>
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-tight text-slate-900 group-hover:text-cyan-600 transition-colors">Apex Dental</span>
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 -mt-1">Modern & Gentle Dentistry</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-7">
          <a href="/#services" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition-colors">Services</a>
          <a href="/#about" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition-colors">About Us</a>
          <a href="/#technology" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition-colors">Technology</a>
          <a href="/#testimonials" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition-colors">Reviews</a>
          <a href="/#contact" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition-colors">Contact</a>
        </nav>

        <!-- CTA & Phone (Zero-JS) -->
        <div class="flex items-center gap-3">
          <a
            href="tel:5553214321"
            class="hidden lg:flex items-center gap-2 text-sm font-medium text-slate-700 hover:text-cyan-600 px-3 py-1.5 rounded-lg transition-colors"
            id="header-phone-cta"
          >
            <svg class="h-4 w-4 text-cyan-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>(555) 321-4321</span>
          </a>
          <a
            href="/#appointment"
            class="inline-flex items-center justify-center rounded-xl bg-cyan-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 transition-all active:scale-[0.98]"
            id="book-appointment-header"
          >
            Book Appointment
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-400 border-t border-slate-800" role="contentinfo">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
          <!-- Column 1: Brand Info -->
          <div>
            <div class="flex items-center gap-2.5 mb-4">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500 to-sky-600 text-white shadow-md">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2C8 2 6 4 6 8c0 3.5 1.5 6 2 9 .4 2.5 1.5 4 4 4s3.6-1.5 4-4c.5-3 2-5.5 2-9 0-4-2-6-6-6Z" />
                  <path d="M9 10c1.5 1 4.5 1 6 0" />
                </svg>
              </span>
              <span class="text-lg font-bold text-white tracking-tight">Apex Dental Studio</span>
            </div>
            <p class="text-sm leading-relaxed text-slate-400 mb-5">
              Providing family and aesthetic dental services with painless techniques, biocompatible materials, and modern digital dentistry.
            </p>
            <div class="flex items-center gap-2 text-xs text-emerald-400 font-medium">
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
              Emergency Appointments Guaranteed Within 24h
            </div>
          </div>

          <!-- Column 2: Clinical Services -->
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Clinical Services</h2>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Preventive Care & Cleanings</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Teeth Whitening & Aesthetics</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Dental Implants & Restorations</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Clear Aligners (Invisalign)</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Pediatric & Family Dentistry</a></li>
              <li><a href="/#services" class="hover:text-cyan-400 transition-colors">Emergency Dental Relief</a></li>
            </ul>
          </div>

          <!-- Column 3: Hours & Location -->
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Office Hours</h2>
            <ul class="space-y-1.5 text-sm text-slate-400">
              <li class="flex justify-between py-1 border-b border-slate-800">
                <span>Monday – Thursday</span>
                <span class="text-white">8:00 AM – 6:00 PM</span>
              </li>
              <li class="flex justify-between py-1 border-b border-slate-800">
                <span>Friday</span>
                <span class="text-white">8:00 AM – 4:00 PM</span>
              </li>
              <li class="flex justify-between py-1 border-b border-slate-800">
                <span>Saturday</span>
                <span class="text-white">9:00 AM – 2:00 PM</span>
              </li>
              <li class="flex justify-between py-1">
                <span>Sunday</span>
                <span class="text-rose-400">Emergency Only</span>
              </li>
            </ul>
          </div>

          <!-- Column 4: Contact & Location -->
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Our Practice</h2>
            <address class="not-italic text-sm space-y-2 text-slate-400">
              <p>420 Medical Pavilion Suite 300<br />Metropolis, NY 10001</p>
              <p>
                <a href="tel:5553214321" class="text-cyan-400 font-semibold hover:underline block">(555) 321-4321</a>
                <a href="mailto:care@apexdentalstudio.example" class="text-slate-400 hover:text-white transition-colors block text-xs">care@apexdentalstudio.example</a>
              </p>
            </address>
            <div class="mt-4 pt-4 border-t border-slate-800 text-xs text-slate-500">
              ADA & AACD Accredited Dental Team
            </div>
          </div>
        </div>

        <!-- Subfooter -->
        <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} Apex Dental Studio. All rights reserved. Zero-JavaScript SSG.</p>
          <div class="flex items-center gap-6">
            <a href="/#contact" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
            <a href="/#contact" class="hover:text-slate-400 transition-colors">HIPAA Compliance</a>
            <a href="/#contact" class="hover:text-slate-400 transition-colors">Accessibility Statement</a>
            <a href="/404" class="hover:text-slate-400 transition-colors">404 Test</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
